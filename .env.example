# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# Banco de dados (Neon). Use a string de conexão COM pooling da branch de
# desenvolvimento, no formato postgresql://...
DATABASE_URL=

# Motor de IA: "mock" (padrão, sem custo, respostas simuladas) ou "real"
# (usa a Claude API e consome créditos).
IA_MODO=mock

# Chave da Anthropic. Obrigatória apenas quando IA_MODO=real.
ANTHROPIC_API_KEY=

# Autenticação (Better Auth). Segredo com pelo menos 32 caracteres, gerado com:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Endereço público do app (em produção, o domínio real com https).
BETTER_AUTH_URL=http://localhost:3000

# E-mail (opcional). Sem a chave, em desenvolvimento o e-mail aparece no terminal.
RESEND_API_KEY=
EMAIL_REMETENTE=Brasa <onboarding@resend.dev>

# Fotos de perfil (opcional): token do Blob Store privado da Vercel
# (Storage > Blob > .env.local). Sem ele, o envio de foto fica indisponível.
# Na Vercel, o SDK usa OIDC e o BLOB_STORE_ID, criados ao conectar o store.
BLOB_READ_WRITE_TOKEN=

# Seed (opcional): senha única dos usuários de demonstração (mínimo de 10
# caracteres). Sem ela, o seed gera uma senha aleatória por usuário e a mostra
# uma única vez no terminal.
SEED_SENHA_DEMO=